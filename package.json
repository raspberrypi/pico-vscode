{
  "name": "raspberry-pi-pico",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.23.1",
  "author": "paulober",
  "publisher": "raspberry-pi",
  "icon": "images/extension-icon.png",
  "license": "MPL-2.0",
  "homepage": "https://github.com/raspberrypi/pico-vscode/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/raspberrypi/pico-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raspberrypi/pico-vscode/"
  },
  "engines": {
    "vscode": "^1.105.1",
    "node": ">=22.19.1"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "raspberry",
    "pi",
    "raspberry pi",
    "pico",
    "pico w",
    "raspberry pi pico",
    "raspberry pi pico w",
    "pico sdk"
  ],
  "categories": [
    "Snippets",
    "Other"
  ],
  "extensionDependencies": [
    "marus25.cortex-debug",
    "paulober.pico-w-go",
    "ms-python.python"
  ],
  "main": "./dist/extension.js",
  "l10n": "./dist/l10n",
  "markdown": "github",
  "minimumNodeVersion": 20,
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Raspberry Pi Pico extension is intended to be used locally."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Raspberry Pi Pico extension is intended to be used in trusted workspaces."
    }
  },
  "activationEvents": [
    "workspaceContains:./pico_sdk_import.cmake",
    "workspaceContains:./.pico-rs",
    "workspaceContains:./prj.conf",
    "onWebviewPanel:newPicoProject",
    "onWebviewPanel:newPicoMicroPythonProject",
    "onWebviewPanel:newPicoRustProject",
    "onWebviewPanel:newPicoZephyrProject",
    "onWebviewPanel:uninstaller"
  ],
  "contributes": {
    "commands": [
      {
        "command": "raspberry-pi-pico.newProject",
        "title": "%command.newProject.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.switchSDK",
        "title": "%command.switchSDK.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !raspberry-pi-pico.isRustProject"
      },
      {
        "command": "raspberry-pi-pico.switchBoard",
        "title": "%command.switchBoard.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject"
      },
      {
        "command": "raspberry-pi-pico.launchTargetPath",
        "title": "%command.launchTargetPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.launchTargetPathRelease",
        "title": "%command.launchTargetPathRelease.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getPythonPath",
        "title": "%command.getPythonPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getEnvPath",
        "title": "%command.getEnvPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getGDBPath",
        "title": "%command.getGDBPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getCompilerPath",
        "title": "%command.getCompilerPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getCxxCompilerPath",
        "title": "%command.getCxxCompilerPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getChip",
        "title": "%command.getChip.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getChipUppercase",
        "title": "%command.getChipUppercase.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getTarget",
        "title": "%command.getTarget.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getPicotoolPath",
        "title": "%command.getPicotoolPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getOpenOCDRoot",
        "title": "%command.getOpenOCDRoot.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getSVDPath",
        "title": "%command.getSVDPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getWestPath",
        "title": "%command.getWestPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getZephyrWorkspacePath",
        "title": "%command.getZephyrWorkspacePath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.compileProject",
        "title": "%command.compileProject.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject"
      },
      {
        "command": "raspberry-pi-pico.runProject",
        "title": "%command.runProject.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject"
      },
      {
        "command": "raspberry-pi-pico.clearGithubApiCache",
        "title": "%command.clearGithubApiCache.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.conditionalDebugging",
        "title": "%command.conditionalDebugging.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !inQuickOpen"
      },
      {
        "command": "raspberry-pi-pico.debugLayout",
        "title": "%command.debugLayout.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject"
      },
      {
        "command": "raspberry-pi-pico.openSdkDocumentation",
        "title": "%command.openSdkDocumentation.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.configureCmake",
        "title": "%command.configureCmake.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !raspberry-pi-pico.isRustProject"
      },
      {
        "command": "raspberry-pi-pico.switchBuildType",
        "title": "%command.switchBuildType.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !raspberry-pi-pico.isRustProject && !raspberry-pi-pico.isZephyrProject"
      },
      {
        "command": "raspberry-pi-pico.importProject",
        "title": "%command.importProject.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.newExampleProject",
        "title": "%command.newExampleProject.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.uninstallPicoSDK",
        "title": "%command.uninstallPicoSDK.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.updateOpenOCD",
        "title": "%command.updateOpenOCD.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.flashProject",
        "title": "%command.flashProject.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !raspberry-pi-pico.isRustProject"
      },
      {
        "command": "raspberry-pi-pico.cleanCmake",
        "title": "%command.cleanCmake.title%",
        "category": "%command.category%",
        "enablement": "raspberry-pi-pico.isPicoProject && !raspberry-pi-pico.isRustProject"
      },
      {
        "command": "raspberry-pi-pico.sbomTargetPathDebug",
        "title": "%command.sbomTargetPathDebug.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.sbomTargetPathRelease",
        "title": "%command.sbomTargetPathRelease.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.getZephyrSDKPath",
        "title": "%command.getZephyrSDKPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.openUninstaller",
        "title": "%command.openUninstaller.title%",
        "category": "%command.category%"
      },
      {
        "command": "raspberry-pi-pico.getGitPath",
        "title": "%command.getGitPath.title%",
        "category": "%command.category%",
        "enablement": "false"
      },
      {
        "command": "raspberry-pi-pico.cleanZephyr",
        "title": "%command.cleanZephyr.title%",
        "category": "%command.category%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "raspberry-pi-pico.cmakePath": {
          "type": "string",
          "default": "",
          "description": "%configuration.cmakePath.description%"
        },
        "raspberry-pi-pico.python3Path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.python3Path.description%"
        },
        "raspberry-pi-pico.ninjaPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.ninjaPath.description%"
        },
        "raspberry-pi-pico.gitPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.gitPath.description%"
        },
        "raspberry-pi-pico.cmakeAutoConfigure": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.cmakeAutoConfigure.description%"
        },
        "raspberry-pi-pico.useCmakeTools": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.useCmakeTools.description%"
        },
        "raspberry-pi-pico.githubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.githubToken.markdownDescription%"
        },
        "raspberry-pi-pico.zephyrVersion": {
          "type": "string",
          "default": "",
          "pattern": "^(?:main|v?\\d+\\.\\d+\\.\\d+(?:-rc\\d+)?)?$",
          "scope": "resource",
          "description": "%configuration.zephyrVersion.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "raspberry-pi-pico-project",
          "title": "%viewsContainer.raspberry-pi-pico-project.title%",
          "icon": "images/24x24-RPi-Pico.svg"
        }
      ]
    },
    "views": {
      "raspberry-pi-pico-project": [
        {
          "id": "raspberry-pi-pico-project-quick-access",
          "name": "%view.raspberry-pi-pico-project-quick-access.name%",
          "type": "tree",
          "icon": "images/24x24-RPi-Pico.svg",
          "contextualTitle": "%view.raspberry-pi-pico-project-quick-access.contextualTitle%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "%viewsWelcome.explorer.0.contents%",
        "when": "workspaceFolderCount == 0"
      }
    ]
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/vscodeUninstaller.mjs",
    "vscode:prepublish": "npm run package",
    "compile": "tsc --build tsconfig.json --noEmit false",
    "genCache": "tsc --build genCache.tsconfig.json --noEmit false && python3 scripts/genCache.py",
    "watch": "node scripts/l10n.mjs && webpack --watch --mode development",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run clean && node scripts/build.mjs",
    "l10n": "node scripts/l10n.mjs",
    "lint": "eslint src && node scripts/l10n.mjs --check",
    "test": "npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.7",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.105.1",
    "@types/which": "^3.0.4",
    "@vscode/l10n-dev": "^0.0.35",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "ts-loader": "^9.5.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.6",
    "adm-zip": "^0.6.1",
    "got": "^14.6.5",
    "ini": "^6.0.0",
    "toml": "^5.0.0",
    "undici": "^7.16.0",
    "which": "^5.0.0",
    "yaml": "^2.8.2"
  },
  "packageManager": "npm@11.6.4+sha512.1118cab46a05a50aee6bff5b1b4fa1df18afff89d57465620a3518035026955db87c5bdf9d207b07b7487d99f2490d450cb774655ad63ec2cba7bf1d0ad25d45"
}
